generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  RETAIL
  INSTITUTION
  ADVISOR
  ADMIN
}
enum Validation {
  PENDING
  APPROVED
  REJECTED
}
enum OrderStatus {
  PENDING
  APPROVED
  SHIPPED
  CANCELLED
}
enum RequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(RETAIL)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  institution Institution?
  sessions Session[]
  cart CartItem[]
  orders Order[]
  requests SpecialRequest[]
}
model Institution {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id])
  name String
  taxId String
  status Validation @default(PENDING)
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  csrf String
  expiresAt DateTime
  @@index([expiresAt])
}
model Author {
  id String @id @default(uuid())
  name String @unique
  biography String @default("")
  active Boolean @default(true)
  books Book[]
}
model Category {
  id String @id @default(uuid())
  name String @unique
  description String @default("")
  active Boolean @default(true)
  books Book[]
}
model Publisher {
  id String @id @default(uuid())
  name String @unique
  books Book[]
}
model Format {
  id String @id @default(uuid())
  name String @unique
  books Book[]
}
model Book {
  id String @id @default(uuid())
  title String
  isbn String @unique
  synopsis String
  year Int
  price Decimal @db.Decimal(12,2)
  cover String @default("")
  active Boolean @default(true)
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  publisherId String
  publisher Publisher @relation(fields:[publisherId], references:[id])
  formatId String
  format Format @relation(fields:[formatId], references:[id])
  authors Author[]
  categories Category[]
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  @@index([active,createdAt])
}
model Inventory {
  bookId String @id
  book Book @relation(fields:[bookId], references:[id])
  stock Int @default(0)
}
model CartItem {
  userId String
  bookId String
  quantity Int
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  book Book @relation(fields:[bookId], references:[id])
  @@id([userId,bookId])
}
model Order {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  userId String
  user User @relation(fields:[userId], references:[id])
  status OrderStatus @default(PENDING)
  breakdown Json
  createdAt DateTime @default(now())
  items OrderItem[]
  history OrderHistory[]
  @@index([userId,createdAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  bookId String
  book Book @relation(fields:[bookId], references:[id])
  title String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
}
model OrderHistory {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  status OrderStatus
  actorId String
  createdAt DateTime @default(now())
}
model SpecialRequest {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id])
  title String
  quantity Int
  coverFinish String
  paper String
  requiredDate DateTime
  notes String @default("")
  status RequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  quote Quote?
  history RequestHistory[]
  @@index([userId,status])
}
model Quote {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  requestId String @unique
  request SpecialRequest @relation(fields:[requestId], references:[id])
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  breakdown Json
  clientSnapshot Json
  validUntil DateTime
  createdAt DateTime @default(now())
}
model RequestHistory {
  id String @id @default(uuid())
  requestId String
  request SpecialRequest @relation(fields:[requestId], references:[id])
  actorId String
  action String
  details String
  createdAt DateTime @default(now())
}
model Setting {
  key String @id
  value String
}
